{% include language-context.liquid %}
{% capture footer_contents %}
  {% if current_lang == 'fr' %}
    &copy; {{ site.time | date: '%Y' }} {{ site.first_name }} {{ site.last_name }}.
    {{ ui.built_with }} <a href="https://jekyllrb.com/" target="_blank" rel="noopener">Jekyll</a>
    {{ ui.and }} <a href="https://github.com/alshedivat/al-folio">al-folio</a>.
  {% else %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% endif %}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    {% if current_lang == 'fr' %}Dernière mise à jour :{% else %}Last updated:{% endif %} {{ 'now' | date: '%Y-%m-%d' }}.
  {% endif %}
{% endcapture %}

{% if site.footer_fixed %}
  <footer class="fixed-bottom" role="contentinfo">
    <div class="container mt-0">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    {% if site.newsletter.enabled %}
      {% include newsletter.liquid %}
    {% endif %}

    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% endif %}
