{% include language-context.liquid %}
{% if site.bib_search %}
  <script src="{{ '/assets/js/bibsearch.js' | relative_url | bust_file_cache }}" type="module"></script>
  <div class="mb-3">
    <input
      type="text"
      id="bibsearch"
      spellcheck="false"
      autocomplete="off"
      class="search bibsearch-form-input"
      placeholder="{{ ui.filter_publications }}"
      aria-label="{{ ui.filter_publications }}"
    >
  </div>
{% endif %}
