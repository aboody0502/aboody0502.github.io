{%- assign current_lang = page.lang | default: site.lang | default: 'en' -%}
{%- assign ui = site.data.ui[current_lang] -%}
{%- assign home_url = ui.home -%}
{%- if current_lang == 'fr' -%}
  {%- assign english_url = page.alternate_url | default: '/' -%}
  {%- assign french_url = page.url -%}
{%- else -%}
  {%- assign english_url = page.url -%}
  {%- assign french_url = page.alternate_url | default: '/fr/' -%}
{%- endif -%}
