---
layout: default
---
{% include language-context.liquid %}
{% if page._styles %}
  <!-- Page/Post style -->
  <style type="text/css">
    {{ page._styles }}
  </style>
{% endif %}

<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if page.title_ar and page.title_en %}
        <bdi lang="ar" dir="rtl">{{ page.title_ar | escape }}</bdi> — <span lang="en">{{ page.title_en | escape }}</span>
      {% else %}
        {{ page.title }}
      {% endif %}
    </h1>
    <p class="post-description">{{ page.description }}</p>
  </header>

  <article>
    {{ content }}
  </article>

  {% if page.related_publications %}
    {% capture related_bibliography %}
      {% bibliography --cited_in_order %}
    {% endcapture %}
    {% assign related_bibliography_text = related_bibliography | strip_html | strip %}
    {% if related_bibliography_text != '' %}
      <h2>{{ ui.references }}</h2>
      <div class="publications">
        {{ related_bibliography }}
      </div>
    {% endif %}
  {% endif %}

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
